# Nexus frontend — build-time environment variables (Vite).
# Copy to .env.local and fill in. Names only in this file; never commit values.
# Only variables prefixed VITE_ reach the browser bundle, so never put a secret here.

# Base URL of the API, INCLUDING the /api suffix.
#   local dev:  http://localhost:3005/api   (also the fallback when unset)
#   production: https://<new-render-service>/api, or /api once the Vercel rewrite exists
VITE_API_BASE_URL=

# Origin of the live chat Socket.IO server (the backend itself), WITHOUT /api.
# Needed in production once VITE_API_BASE_URL is the relative /api rewrite,
# because Vercel rewrites do not proxy WebSockets.
#   local dev:  unset (uses the origin of VITE_API_BASE_URL, or http://localhost:3005)
#   production: https://<new-render-service>
VITE_SOCKET_URL=
